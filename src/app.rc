#include <windows.h>

// O Windows usa como icone da aplicacao o recurso ICON de menor ID.
1 ICON "../assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"  // pt-BR, Unicode
        BEGIN
            VALUE "FileDescription",  "Vertical Aim Controller"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "vertical-aim-controller"
            VALUE "OriginalFilename", "vertical-aim-controller.exe"
            VALUE "ProductName",      "Vertical Aim Controller"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
